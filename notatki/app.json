{
  "configVersion": "v3",
  "app": {
    "appId": 1099001,
    "appName": "Notatki",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "adam",
    "description": "Notatki z Gemini (Markdown + LaTeX) na zegarek"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
  "runtime": {
    "apiVersion": { "compatible": "3.6", "target": "3.6", "minVersion": "3.6" }
  },
  "debug": false,
  "targets": {
    "common": {
      "module": {
        "page": { "pages": ["page/index", "page/detail"] },
        "app-side": { "path": "app-side/index" },
        "setting": { "path": "setting/index" }
      },
      "platforms": [{ "st": "r" }, { "st": "s" }, { "st": "b" }],
      "designWidth": 480
    }
  },
  "i18n": {
    "pl-PL": { "appName": "Notatki" },
    "en-US": { "appName": "Notatki" }
  },
  "defaultLanguage": "en-US"
}
